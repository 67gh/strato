// Block-matching motion estimation used by the frame generation pass.
// Produces a per-block motion vector field (in pixels, previous -> current)
// which is later upsampled and used to motion-compensate interpolated frames.
//
// This runs one workgroup per output block (BLOCK_SIZE x BLOCK_SIZE px) and
// performs a diamond search around the predicted motion vector from the
// previous (coarser) pyramid level, falling back to a small brute-force
// search on the coarsest level.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uPrevFrame; //!< The previous presented frame (N-1)
layout(set = 0, binding = 1) uniform sampler2D uCurrFrame; //!< The most recently presented frame (N)
layout(set = 0, binding = 2) uniform sampler2D uPrevMotion; //!< Motion field from the next coarser pyramid level (rg = motion in px), or unused at level 0
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D uMotionOut; //!< Output motion vector field for this level, one texel per block

layout(push_constant) uniform PushConstants {
    ivec2 frameExtent;     //!< Dimensions of uCurrFrame/uPrevFrame at this pyramid level
    ivec2 motionOutExtent; //!< Dimensions of uMotionOut (== frameExtent / BLOCK_SIZE, rounded up)
    int blockSize;         //!< Size of a motion-estimation block in pixels at this level
    int searchRadius;      //!< Maximum search radius in pixels around the predicted vector (fixed at 4 - matches the 8x8 candidate grid below)
    int hasPrevLevel;      //!< 1 if uPrevMotion contains a valid coarser-level prediction, 0 for the coarsest level
} pc;

// One workgroup handles one output block. Every one of the 64 invocations tests a different
// candidate motion vector in parallel (an 8x8 grid of offsets around the predicted vector), then
// a shared-memory reduction picks the cheapest candidate. This keeps the whole workgroup busy
// instead of a single thread doing a serial search, which is essential for real-time performance.
shared float sCost[64];
shared ivec2 sOffset[64];

float Luma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

// Sum of absolute differences between a block in uCurrFrame at 'blockOrigin' and
// a block in uPrevFrame at 'blockOrigin + offset'
float BlockSad(ivec2 blockOrigin, ivec2 offset) {
    float sad = 0.0;
    int bs = pc.blockSize;
    for (int y = 0; y < bs; y += 4) { // Sparse sampling keeps the per-invocation cost low since we now have 64x more parallel candidates than before
        for (int x = 0; x < bs; x += 4) {
            ivec2 currPos = clamp(blockOrigin + ivec2(x, y), ivec2(0), pc.frameExtent - 1);
            ivec2 prevPos = clamp(currPos + offset, ivec2(0), pc.frameExtent - 1);

            float lumaCurr = Luma(texelFetch(uCurrFrame, currPos, 0).rgb);
            float lumaPrev = Luma(texelFetch(uPrevFrame, prevPos, 0).rgb);
            sad += abs(lumaCurr - lumaPrev);
        }
    }
    return sad;
}

void main() {
    ivec2 blockCoord = ivec2(gl_WorkGroupID.xy);
    if (blockCoord.x >= pc.motionOutExtent.x || blockCoord.y >= pc.motionOutExtent.y)
        return;

    ivec2 blockOrigin = blockCoord * pc.blockSize;

    ivec2 predicted = ivec2(0);
    if (pc.hasPrevLevel == 1) {
        // The coarser level has half the resolution in blocks, so each texel there
        // corresponds to a 2x2 neighbourhood of blocks here; upsample the vector and
        // scale it by 2 since we're now at double the spatial resolution.
        ivec2 coarseCoord = blockCoord / 2;
        vec2 coarseMotion = texelFetch(uPrevMotion, coarseCoord, 0).rg;
        predicted = ivec2(round(coarseMotion * 2.0));
    }

    // This invocation's candidate: predicted vector + a unique offset from the 8x8 grid,
    // scaled by the step size so the whole grid covers +/- searchRadius pixels
    ivec2 localId = ivec2(gl_LocalInvocationID.xy) - ivec2(4); // -4..3 in each axis
    int step = max(pc.searchRadius / 4, 1);
    ivec2 candidate = predicted + localId * step;

    uint idx = gl_LocalInvocationIndex;
    sCost[idx] = BlockSad(blockOrigin, candidate);
    sOffset[idx] = candidate;
    barrier();

    // Parallel reduction to find the minimum-cost candidate across all 64 invocations
    for (uint activeCount = 32u; activeCount > 0u; activeCount >>= 1u) {
        if (idx < activeCount && sCost[idx + activeCount] < sCost[idx]) {
            sCost[idx] = sCost[idx + activeCount];
            sOffset[idx] = sOffset[idx + activeCount];
        }
        barrier();
    }

    if (idx == 0u)
        imageStore(uMotionOut, blockCoord, vec4(vec2(sOffset[0]), 0.0, 0.0));
}
