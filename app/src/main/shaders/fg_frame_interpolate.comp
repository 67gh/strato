// Generates one intermediate frame between uPrevFrame and uCurrFrame at
// interpolation factor 't' (0 < t < 1), using the block motion field computed
// by fg_motion_estimate.comp. Performs a bidirectional warp of both source
// frames towards the intermediate timestamp and blends them, with a simple
// disocclusion fallback so newly-revealed areas don't sample garbage.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uPrevFrame;
layout(set = 0, binding = 1) uniform sampler2D uCurrFrame;
layout(set = 0, binding = 2) uniform sampler2D uMotion; //!< Finest-level motion field (px, prev -> curr), one texel per block
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D uOutput; //!< The generated intermediate frame

layout(push_constant) uniform PushConstants {
    ivec2 frameExtent;
    int blockSize;
    float t; //!< Interpolation factor, e.g. 1/2 for 2x, 1/3 & 2/3 for 3x, 1/4 2/4 3/4 for 4x
} pc;

vec2 SampleMotion(ivec2 pixel) {
    ivec2 blockCoord = pixel / pc.blockSize;
    return texelFetch(uMotion, blockCoord, 0).rg;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.frameExtent.x || pixel.y >= pc.frameExtent.y)
        return;

    vec2 motion = SampleMotion(pixel); // Full displacement from prev -> curr at this pixel's block
    vec2 extentF = vec2(pc.frameExtent);

    // Forward-warp: move the previous frame's content forward by t, and the
    // current frame's content backward by (1 - t), then meet in the middle.
    vec2 prevSampleUv = (vec2(pixel) - motion * pc.t + 0.5) / extentF;
    vec2 currSampleUv = (vec2(pixel) + motion * (1.0 - pc.t) + 0.5) / extentF;

    bool prevInBounds = all(greaterThanEqual(prevSampleUv, vec2(0.0))) && all(lessThanEqual(prevSampleUv, vec2(1.0)));
    bool currInBounds = all(greaterThanEqual(currSampleUv, vec2(0.0))) && all(lessThanEqual(currSampleUv, vec2(1.0)));

    vec4 colour;
    if (prevInBounds && currInBounds) {
        vec4 prevColour = texture(uPrevFrame, prevSampleUv);
        vec4 currColour = texture(uCurrFrame, currSampleUv);

        // Weight samples by how large the motion is: large/uncertain motion leans
        // on the closer source frame to reduce ghosting on fast-moving edges.
        float motionMagnitude = length(motion) / max(extentF.x, extentF.y);
        float blendBias = clamp(motionMagnitude * 4.0, 0.0, 0.35);
        float wCurr = pc.t + blendBias * (pc.t - 0.5);
        wCurr = clamp(wCurr, 0.0, 1.0);

        colour = mix(prevColour, currColour, wCurr);
    } else if (currInBounds) {
        // Disocclusion: the predicted source pixel in one frame fell outside the
        // image (content revealed by motion), fall back to the other frame.
        colour = texture(uCurrFrame, currSampleUv);
    } else if (prevInBounds) {
        colour = texture(uPrevFrame, prevSampleUv);
    } else {
        // Both warps missed (large/erroneous motion vector) - fall back to a
        // plain temporal blend at this pixel's un-warped location.
        vec2 uv = (vec2(pixel) + 0.5) / extentF;
        colour = mix(texture(uPrevFrame, uv), texture(uCurrFrame, uv), pc.t);
    }

    imageStore(uOutput, pixel, colour);
}
